    },
    {
      "kind": "unsigned_reference",
      "pattern": "不在证据台账|引用 .*条|文献 .*不在"
    },
    {
      "kind": "budget_stop",
      "pattern": "预算"
    },
    {
      "kind": "org_rejected",
      "pattern": "编制|角色|阶段只有"
